# Use a published release tag to pin an upgrade, or "latest" to follow main.
AI_WORLD_TAG=latest

# A reverse proxy on this Docker host can reach loopback. Set 0.0.0.0 only when
# you deliberately want other machines to reach the plain HTTP port directly.
AI_WORLD_BIND=127.0.0.1

# Set to 1 only behind a trusted reverse proxy that overwrites X-Forwarded-Proto.
TRUST_PROXY=0

# Fill these in before starting Compose. Generate the secret and password with
# the commands in docs/self-hosting.md; never commit your populated .env file.
TOOLS_SECRET=
TOOLS_ADMIN_USER=
TOOLS_ADMIN_PASSWORD=
