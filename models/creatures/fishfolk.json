    { "note": "The crest, which is what makes it a fish from behind as well as from in front.", "cone": [0.1, 0.34], "at": [-0.02, 1.52, 0], "color": "#ffffff", "tint": 1, "anim": "head", "pivot": [0, 1.12, 0], "rot": [0, 0, -0.25] },
    { "note": "Eyes on the sides of the head rather than the front of it, which is the whole difference between a fish and a man.", "ico": 0.09, "at": [0.18, 1.32, 0.14], "color": "#e8d98a", "anim": "head", "pivot": [0, 1.12, 0] },
