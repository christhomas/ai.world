node_modules
dist/
.DS_Store
server/data/

# local-only Claude Code settings (worktree base, permissions)
.claude/settings.local.json

# agent worktrees live here; they are checkouts, not content
.claude/worktrees/

# the design canvas is seeded from design/*.dc.html and published; the seeded page is a
