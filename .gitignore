ai-world-interface.html

# throwaway scripts for looking at the game — screenshots, one-off probes
.scratch/

# the note a killed `chore fallbacks` leaves behind, so the next run knows to tidy up
.fallbacks-in-flight

# every bench and tool writes its account of a run here, and none of them is tracked: a generated
# file in git conflicts on every rebase, goes stale, and is then believed. See src/core/reports.ts
docs/reports/
